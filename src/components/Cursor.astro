<div class="cursor" data-cursor aria-hidden="true"></div>

<script>
  const cursor = document.querySelector<HTMLElement>('[data-cursor]');
  if (cursor && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.documentElement.classList.add('has-cursor');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = still ? 1 : 0.35;
    let x = -100;
    let y = -100;
    let cx = x;
    let cy = y;

    // each trail dot chases the one ahead of it, so the tail stretches with speed
    const trail = Array.from({ length: still ? 0 : 6 }, (_, i) => {
      const el = document.createElement('div');
      el.className = 'cursor-trail';
      el.style.setProperty('--i', String(i));
      cursor.before(el);
      return { el, x, y };
    });

    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      const over = !!(e.target as Element).closest('a, button');
      cursor.classList.add('on');
      cursor.classList.toggle('over', over);
      document.documentElement.classList.toggle('cursor-over', over);
      document.documentElement.classList.add('cursor-on');
    });
    document.addEventListener('pointerleave', () => {
      cursor.classList.remove('on');
      document.documentElement.classList.remove('cursor-on');
    });
    addEventListener('pointerdown', () => cursor.classList.add('down'));
    addEventListener('pointerup', () => cursor.classList.remove('down'));

    const loop = () => {
      cx += (x - cx) * ease;
      cy += (y - cy) * ease;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      let lead = { x: cx, y: cy };
      for (const t of trail) {
        t.x += (lead.x - t.x) * 0.45;
        t.y += (lead.y - t.y) * 0.45;
        t.el.style.transform = `translate3d(${t.x}px, ${t.y}px, 0)`;
        lead = t;
      }
      requestAnimationFrame(loop);
    };
    loop();
  }
</script>

<style>
  :global(.has-cursor),
  :global(.has-cursor *) {
    cursor: none !important;
  }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .cursor::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--text);
    transition:
      transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 250ms ease;
  }

  .cursor:global(.on) {
    opacity: 1;
  }

  :global(.cursor-trail) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99;
    width: 0;
    height: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  :global(.cursor-trail)::after {
    content: '';
    position: absolute;
    --s: calc(6px - var(--i) * 0.7px);
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    background: var(--text);
  }

  :global(.cursor-on .cursor-trail) {
    opacity: calc(0.28 - var(--i) * 0.04);
  }

  :global(.cursor-on.cursor-over .cursor-trail) {
    opacity: 0;
  }

  .cursor:global(.over)::after {
    transform: scale(4);
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  .cursor:global(.down)::after {
    transform: scale(0.75);
  }

  .cursor:global(.over.down)::after {
    transform: scale(3.4);
  }
</style>
