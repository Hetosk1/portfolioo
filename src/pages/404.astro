---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Het Jasani" description="This page doesn't exist.">
  <div class="page">
    <header>
      <a class="name" href="/">Het Jasani</a>
    </header>

    <main class="lost">
      <p class="code meta">404</p>
      <h1>Nothing lives at <em>this address</em>.</h1>
      <p class="muted">It may have moved, or it never existed. Either way, it's not your fault.</p>
      <a class="home" href="/">Back home <span aria-hidden="true">→</span></a>
    </main>
  </div>
</Base>

<style>
  .name {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .lost {
    margin-top: 10rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(1.875rem, 1.25rem + 2.4vw, 2.625rem);
    line-height: 1.14;
    font-weight: 500;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .muted {
    margin-top: 1.25rem;
  }

  .home {
    display: inline-block;
    margin-top: 2.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .lost {
      margin-top: 6rem;
    }
  }
</style>
